// === Motor control pins ===
#define in1 7
#define in2 8
#define in3 9
#define in4 10
#define enA 6
#define enB 5

// === Buzzer ===
#define BUZZER_PIN 13

// === Ultrasonic Sensor ===
const int trigPin = 11;
const int echoPin = 12;
long duration;
int distance;

// === Motor Speeds ===
int M1_Speed = 160;
int M2_Speed = 160;
int LeftRotationSpeed = 225;
int RightRotationSpeed = 225;

// === Sensor Pins ===
int LEFT_SENSOR, RIGHT_SENSOR; // 4 and 3
bool lineFollowing = false;
bool returning = true;

// === Load Detection ===
bool lastLoadState = false;
bool stableLoadState = false;
unsigned long lastStateChangeTime = 0;

// === Setup ===
void setup() {
  delay(random(750, 2000)); // Random delay at start
  Serial.begin(9600);

  // Motor Pins
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);
  pinMode(enA, OUTPUT);
  pinMode(enB, OUTPUT);

  // Sensor Pins
  pinMode(4, INPUT);  // LEFT_SENSOR
  pinMode(3, INPUT);  // RIGHT_SENSOR

  // Ultrasonic
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // Buzzer
  pinMode(BUZZER_PIN, OUTPUT);
}

// === Main Loop ===
void loop() {
  // Serial commands
  if (Serial.available()) {
    char cmd = Serial.read();
    if (cmd == 'S') {
      lineFollowing = true;
      returning = false;
      beepBuzzer();
      Serial.println("STARTED");
    } else if (cmd == 'F') {
      lineFollowing = false;
      returning = false;
      Stop();
      Serial.println("STOPPED");
    } else if (cmd == 'R') {
      returning = true;
      lineFollowing = false;
      beepBuzzer();
      Serial.println("RETURN MODE ACTIVATED");
    }
  }

  // Ultrasonic Load Detection
  distance = getDistance();
  bool currentLoadState = (distance > 0 && distance < 20);
  if (currentLoadState != lastLoadState) {
    lastLoadState = currentLoadState;
    Serial.println(currentLoadState ? "ROVER LOADED" : "ROVER EMPTY");
  }
  checkLoadStatus();

  // === Line Following Logic (Your Code) ===
  if (lineFollowing) {
    LEFT_SENSOR = digitalRead(4);
    RIGHT_SENSOR = digitalRead(3);

    if (RIGHT_SENSOR == 0 && LEFT_SENSOR == 0) {
      forward();
    } else if (RIGHT_SENSOR == 0 && LEFT_SENSOR == 1) {
      right();
    } else if (RIGHT_SENSOR == 1 && LEFT_SENSOR == 0) {
      left();
    } else if (RIGHT_SENSOR == 1 && LEFT_SENSOR == 1) {
      Stop();
      Stop();
    }
    delay(1);
  }

  // === Returning Logic Placeholder ===
  if (returning) {
    returnToStart();
  }

}

// === Movement Functions ===
void forward() {
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
  analogWrite(enA, M1_Speed);
  analogWrite(enB, M2_Speed);
}

void backward() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
  analogWrite(enA, M1_Speed);
  analogWrite(enB, M2_Speed);
}

void right() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, LOW);
  digitalWrite(in4, HIGH);
  analogWrite(enA, LeftRotationSpeed);
  analogWrite(enB, RightRotationSpeed);
}

void left() {
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
  analogWrite(enA, LeftRotationSpeed);
  analogWrite(enB, RightRotationSpeed);
}

void Stop() {
  digitalWrite(in1, HIGH);
  digitalWrite(in2, HIGH);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, HIGH);
  analogWrite(enA, 0);
  analogWrite(enB, 0);
}

// === Buzzer ===
void beepBuzzer() {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(300);
  digitalWrite(BUZZER_PIN, LOW);
}

// === Distance Sensor ===
int getDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH, 30000);
  return duration * 0.034 / 2;
}

// === Load Check with Debounce ===
void checkLoadStatus() {
  static bool lastReading = false;
  static unsigned long lastDebounceTime = 0;
  const unsigned long debounceDelay = 300;

  distance = getDistance();
  bool currentReading = (distance > 0 && distance < 15);

  if (currentReading != lastReading) {
    lastDebounceTime = millis();
    lastReading = currentReading;
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (currentReading != stableLoadState) {
      stableLoadState = currentReading;
      Serial.println(stableLoadState ? "ROVER LOADED" : "ROVER EMPTY");
    }
  }
}
// === Return Logic: 180° turn until line is detected, then follow until line ends ===
void returnToStart() {
  // Step 1: Rotate to find the line
  int searchStart = millis();
  while (true) {
    LEFT_SENSOR = digitalRead(4);
    RIGHT_SENSOR = digitalRead(3);

    if (LEFT_SENSOR == 0 || RIGHT_SENSOR == 0) {
      Serial.println("LINE FOUND - BEGIN FOLLOWING BACK");
      break;  // Exit loop once line is found
    }

    // Spin left or right slowly to search
    left();  // You can change to right() depending on setup
    delay(1000);

    // Safety timeout
    if (millis() - searchStart > 5000) {
      Serial.println("LINE NOT FOUND AFTER ROTATION");
      Stop();
      return;
    }
  }

  // Step 2: Follow the line until both sensors go high (white surface)
  while (true) {
    LEFT_SENSOR = digitalRead(4);
    RIGHT_SENSOR = digitalRead(3);

    if (LEFT_SENSOR == 1 && RIGHT_SENSOR == 1) {
      Serial.println("LINE ENDED - STOPPING");
      Stop();
      returning = false;
      break;
    }

    if (RIGHT_SENSOR == 0 && LEFT_SENSOR == 0) {
      forward();
    } else if (RIGHT_SENSOR == 0 && LEFT_SENSOR == 1) {
      right();
    } else if (RIGHT_SENSOR == 1 && LEFT_SENSOR == 0) {
      left();
    } else {
      Stop();
    }
    delay(5);
  }
}
